{
	"name": "web-porridge",
	"version": "5.0.0",
	"description": "Feature-enhanced wrappers for the Storage and IndexedDB APIs",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "npm run build -- --watch",
		"fix": "biome check --fix",
		"lint": "biome check",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np --package-manager pnpm --any-branch",
		"start": "npm run dev",
		"test": "vitest run",
		"test:coverage": "vitest --coverage --ui",
		"test:watch": "vitest"
	},
	"type": "module",
	"typings": "./lib/index.d.mts",
	"exports": {
		".": {
			"types": "./lib/index.d.mts",
			"import": "./lib/index.mjs"
		}
	},
	"files": [
		"lib/",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/web-porridge.git"
	},
	"keywords": [
		"webstorage",
		"local-storage",
		"localstorage",
		"session-storage",
		"sessionstorage",
		"storage api",
		"indexeddb"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"engineStrict": true,
	"dependencies": {
		"dot-prop": "^10.2.0",
		"idb-keyval": "^6.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@idleberg/configs": "^0.4.6",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"@vitest/browser": "^5.1.0",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/ui": "5.1.0",
		"np": "^12.1.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.21.0"
}
