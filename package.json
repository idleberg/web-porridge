{
	"name": "web-porridge",
	"version": "4.0.2",
	"description": "Feature-enhanced wrappers for the Storage and IndexedDB APIs",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "npm run build -- --watch",
		"fix": "biome check --fix",
		"lint:code": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"lint": "concurrently --prefix '{name}' -c 'blue,green,magenta' 'npm:lint:*'",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np --package-manager pnpm --any-branch",
		"start": "npm run dev",
		"test": "vitest run",
		"test:coverage": "vitest --coverage --ui",
		"test:watch": "vitest"
	},
	"type": "module",
	"typings": "./lib/index.d.mts",
	"exports": {
		".": {
			"types": "./lib/index.d.mts",
			"import": "./lib/index.mjs"
		}
	},
	"files": [
		"lib/",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/web-porridge.git"
	},
	"keywords": [
		"webstorage",
		"local-storage",
		"localstorage",
		"session-storage",
		"sessionstorage",
		"storage api",
		"indexeddb"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"engineStrict": true,
	"dependencies": {
		"dot-prop": "^10.2.0",
		"idb-keyval": "^6.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@idleberg/configs": "^0.4.6",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"@vitest/browser": "^5.1.0",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/ui": "5.1.0",
		"concurrently": "^10.0.7",
		"np": "^12.1.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef"
}
